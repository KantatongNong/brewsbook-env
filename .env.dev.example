# Brewsbook DEV (192.168.3.94) — copy to .env on the server. NEVER commit .env
COMPOSE_PROJECT_NAME=brewsbook-dev

# External MySQL (container brewbook-mysql on db-brewbook_app-network)
# Source password from /opt/dev-brewsbook/app-brewsbook/.env (database.default.password)
# Do NOT invent a new DB password.
MYSQL_DATABASE=dev_brewbook
MYSQL_USER=dbBrew
MYSQL_PASSWORD=CHANGE_ME_FROM_SERVER_ENV
DB_HOST=brewbook-mysql
DB_PORT=3306

# Keycloak (start-dev + /auth relative path behind Apache TLS)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_KC
KEYCLOAK_REALM=brewsbook

# Public URLs (same origin via host Apache → Caddy :8888)
PUBLIC_WEB_URL=https://dev-brewsbook.dxtms.com
PUBLIC_API_URL=https://dev-brewsbook.dxtms.com
PUBLIC_KEYCLOAK_URL=https://dev-brewsbook.dxtms.com/auth
OIDC_ISSUER=https://dev-brewsbook.dxtms.com/auth/realms/brewsbook
NEXT_PUBLIC_OIDC_ISSUER=https://dev-brewsbook.dxtms.com/auth/realms/brewsbook
NEXT_PUBLIC_OIDC_CLIENT_ID=brewsbook-nextjs
OIDC_API_CLIENT_ID=brewsbook-api
OIDC_API_CLIENT_SECRET=
OIDC_JWKS_URL=http://keycloak:8080/auth/realms/brewsbook/protocol/openid-connect/certs
OIDC_ALLOWED_AZP=brewsbook-nextjs,brewsbook-api
CORS_ALLOWED_ORIGINS=https://dev-brewsbook.dxtms.com

# Edge: replace old PHP Hello World on host :8888
CADDY_HTTP_PORT=8888
