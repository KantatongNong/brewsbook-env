# Brewsbook local/dev — copy to .env and fill values. NEVER commit .env
COMPOSE_PROJECT_NAME=brewsbook

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=brewsbook
MYSQL_USER=brewsbook
MYSQL_PASSWORD=change-me-db
MYSQL_PORT=3306

# Keycloak (start-dev — local only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc
KEYCLOAK_HTTP_PORT=8081
KEYCLOAK_HOSTNAME=localhost
KC_DB=dev-file
# Realm imported from keycloak/realm-brewsbook.json
KEYCLOAK_REALM=brewsbook

# OIDC clients (public values OK; secrets stay empty for public nextjs client)
OIDC_ISSUER=http://localhost:8081/realms/brewsbook
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:8081/realms/brewsbook
NEXT_PUBLIC_OIDC_CLIENT_ID=brewsbook-nextjs
# API confidential client secret — set after first Keycloak boot if needed
OIDC_API_CLIENT_ID=brewsbook-api
OIDC_API_CLIENT_SECRET=
# Optional. Compose defaults: JWKS via http://keycloak:8080, browser issuer stays OIDC_ISSUER.
# OIDC_JWKS_URL=http://keycloak:8080/realms/brewsbook/protocol/openid-connect/certs
# OIDC_ALLOWED_AZP=brewsbook-nextjs,brewsbook-api
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost

# App URLs (local)
WEB_URL=http://localhost:3000
API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
PUBLIC_KEYCLOAK_URL=http://localhost:8081

# Reverse proxy
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Stub service ports (host)
WEB_PORT=3000
API_PORT=8080
