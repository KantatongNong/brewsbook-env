# CodeIgniter-style env — mirrors key NAMES from /opt/dev-brewsbook/app-brewsbook/.env
# Copy to app-brewsbook/.env (or root .env on server) and fill secrets locally.
# NEVER commit real passwords.

CI_ENVIRONMENT=development

# Public URL behind reverse proxy / TLS terminator
app.baseURL=https://dev-brewsbook.dxtms.com/

# MySQL on DEV host (external to this compose) — OVPN required from laptop
# Host listens on 192.168.3.94:3305 ; from inside container use host.docker.internal
# or the host LAN IP if extra_hosts is set.
database.default.hostname=192.168.3.94
database.default.database=dev_brewbook
database.default.username=dbBrew
database.default.password=CHANGE_ME
database.default.DBDriver=MySQLi
database.default.charSet=utf8mb4
database.default.DBCollat=utf8mb4_general_ci
database.default.port=3305

app.appTimezone=Asia/Bangkok

# Writable paths inside the app tree (adjust when CI skeleton lands)
cache.file.storePath=WRITEPATH/cache/
session.savePath=WRITEPATH/session/
