# Brewsbook local reverse proxy
# Host access also works via published ports (3000/8080/8081) without Caddy.

:80 {
	# Path-based routing for a single local edge
	handle /auth* {
		reverse_proxy keycloak:8080
	}
	handle /api* {
		uri strip_prefix /api
		reverse_proxy api:80
	}
	handle /health {
		reverse_proxy api:80
	}
	handle {
		reverse_proxy web:3000
	}
}

# Optional local HTTPS (Caddy internal CA). Browse https://localhost after trusting Caddy local CA.
localhost {
	tls internal
	handle /auth* {
		reverse_proxy keycloak:8080
	}
	handle /api* {
		uri strip_prefix /api
		reverse_proxy api:80
	}
	handle /health {
		reverse_proxy api:80
	}
	handle {
		reverse_proxy web:3000
	}
}
